{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": "auth != null && data.child('host').val() === auth.uid",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'roundId', 'card']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "claims": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'type', 'roundId', 'at'])",
            "at": { ".validate": "!data.exists() ? newData.val() === now : newData.val() === data.val()" },
            "verdict": { ".validate": "root.child('rooms').child($code).child('host').val() === auth.uid" }
          }
        }
      }
    }
  }
}
